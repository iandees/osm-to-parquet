{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osmpq",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // `mapki.com` is already an active zone on this account; wrangler
  // provisions the DNS record + SSL for this hostname on deploy.
  "routes": [
    { "pattern": "osmpq.mapki.com", "custom_domain": true }
  ],

  // Non-secret config. `OSMPQ_S3_KEY_ID`, `OSMPQ_S3_SECRET`,
  // `OSMPQ_S3_ENDPOINT` and `ADMIN_TOKEN` are secrets (see README) and are
  // never set here.
  "vars": {
    // Root of the dataset the engine and updater read/write, as an
    // `s3://` URL (R2 bucket + prefix) once a real dataset is synced; see
    // `docs/m3-runbook.md`.
    "OSMPQ_ROOT": "s3://osm-parquet/us",
    // Shown verbatim in `/api/status`; set to the public URL clients use.
    "OSMPQ_ANNOUNCED_ENDPOINT": "https://osmpq.mapki.com/api/interpreter",
    // Minutely-replication source the updater polls (osmium/osmosis
    // state-file style base URL), e.g. the OSM planet replication server
    // or a regional mirror.
    "OSMPQ_REPLICATION_SOURCE": "https://planet.openstreetmap.org/replication/minute",
    // How many EngineContainer instances the Worker load-balances across
    // with `getRandom` (`src/index.ts`). Raise this, and `max_instances`
    // below, as traffic grows; see the runbook.
    "ENGINE_INSTANCES": 2
  },

  "containers": [
    {
      "name": "osmpq-engine",
      "class_name": "EngineContainer",
      // The repo-root Dockerfile (workstream W4): `osmpq serve` on 8080,
      // `osmpq updater-server` on 8081, same image for both container
      // classes below.
      "image": "../../Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 2
    },
    {
      "name": "osmpq-updater",
      "class_name": "UpdaterContainer",
      "image": "../../Dockerfile",
      "instance_type": "standard-3",
      // Exactly one: the updater is a single stateless-but-serial
      // process (`docs/design.md` section 4.1/4.2); `UpdaterScheduler`
      // always addresses the same named instance.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ENGINE", "class_name": "EngineContainer" },
      { "name": "UPDATER", "class_name": "UpdaterContainer" },
      { "name": "SCHEDULER", "class_name": "UpdaterScheduler" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EngineContainer", "UpdaterContainer", "UpdaterScheduler"]
    }
  ],

  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Replace with the namespace id `wrangler` prints when this config
      // is first deployed (Cloudflare allocates it; see the runbook).
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
